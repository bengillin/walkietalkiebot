{
  "name": "walkietalkiebot",
  "version": "0.3.8",
  "description": "Walkie Talkie Bot — a voice-first AI assistant for Claude Code. Use as a Claude Code plugin (30 MCP tools + 5 skills, offline SQLite) or full server (web UI, 6 retro themes, voice)",
  "homepage": "https://walkietalkie.bot",
  "repository": {
    "type": "git",
    "url": "https://github.com/bengillin/walkietalkiebot"
  },
  "type": "module",
  "bin": {
    "walkietalkiebot": "bin/wtb.js",
    "wtb": "bin/wtb.js",
    "wtb-server": "bin/wtb-server.js",
    "wtb-mcp": "mcp-server/dist/index.js"
  },
  "files": [
    "bin/wtb.js",
    "bin/wtb-server.js",
    "mcp-server/dist/",
    "server/**/*.js",
    "dist/",
    ".claude-plugin/",
    "skills/",
    ".mcp.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:server",
    "build:server": "node scripts/build-server.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.config.server.ts",
    "test:client": "vitest run",
    "test:server": "vitest run --config vitest.config.server.ts",
    "test:e2e": "npx playwright test e2e/app.spec.ts",
    "test:visual": "npx playwright test e2e/visual.spec.ts",
    "test:visual:update": "npx playwright test e2e/visual.spec.ts --update-snapshots",
    "test:watch": "vitest",
    "version": "node scripts/sync-version.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "voice",
    "ai",
    "assistant",
    "mcp",
    "speech-recognition",
    "text-to-speech",
    "cassette",
    "retro",
    "themes",
    "tts",
    "wake-word",
    "plugin",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "hono": "^4.4.0",
    "open": "^10.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  }
}
